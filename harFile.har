          "content": {
            "size": 14774,
            "mimeType": "application/json",
            "text": "{\n  \"COMMON_RULES\": \"Common Rules\",\n  \"COMMON_RULES_BUTTON\": \"Common\\nRules\",\n  \"CR_AB_BUY_BONUS\": \"When Ante Bet is activated, the Buy Bonus Feature is disabled\",\n  \"CR_AB_GENERAL_BONUS\": \"A 25% increase in bet doubles the chance to win a Bonus Game. More BONUS symbols are present on the reels\",\n  \"CR_AB_GENERAL_FREE_SPINS\": \"A 25% increase in bet doubles the chance to win Free Spins. More SCATTER symbols are present on the reels\",\n  \"CR_ANTE_BET\": \"Ante Bet\",\n  \"CR_BF_3_REEL_MG_FS\": \"The BOOST symbol can appear on the 3rd reel during Main Game and Free Spins\",\n  \"CR_BF_ANY_GAME_MODE\": \"The BOOST symbol can appear in any game mode\",\n  \"CR_BF_ANY_REEL_BG\": \"The BOOST symbol can appear on any reel during Bonus Game\",\n  \"CR_BG_3_RESPINS\": \"3 respins are granted at the beginning of Bonus Game\",\n  \"CR_BG_4_RESPINS\": \"4 respins are granted at the beginning of Bonus Game\",\n  \"CR_BG_ALL_BONUS_STICK\": \"All BONUS symbols stick on the reels during Bonus Game\",\n  \"CR_BG_ALL_SYMBOLS_STICK\": \"All symbols stick on the reels during Bonus Game\",\n  \"CR_BG_BALL_VALUES\": \"Possible values of the BONUS Symbol: {ball_values} X #PAYTABLE_TB_FULL\",\n  \"CR_BG_BOOST_VALUES\": \"Possible values of the BOOST Symbol: {boost_values}\",\n  \"CR_BG_CAN_TRIGGER_IN_FS\": \"The Bonus Game can be triggered in Free Spins\",\n  \"CR_BG_COLLECT_MULTIPLIER_VALUES\": \"Possible multipliers of the COLLECT Symbol: {collect_multiplier_values}\",\n  \"CR_BG_CONTINUE_UNTIL_15_BONUS\": \"The Bonus Game continues until respins are finished or all 15 BONUS symbols are collected\",\n  \"CR_BG_CONTINUE_UNTIL_20_BONUS\": \"The Bonus Game continues until respins are finished or all 20 BONUS symbols are collected\",\n  \"CR_BG_CONTINUE_UNTIL_9_BONUS\": \"The Bonus Game continues until respins are finished or all 9 BONUS symbols are collected\",\n  \"CR_BG_CONTINUE_UNTIL_ALL_SYMBOLS\": \"The Bonus Game continues until respins are finished or the entire field is filled with symbols\",\n  \"CR_BG_EACH_BONUS_RESET_RESPINS\": \"Each new BONUS symbol appearing on the reels resets the number of respins to 3\",\n  \"CR_BG_EACH_BONUS_RESET_RESPINS_4\": \"Each new BONUS symbol appearing on the reels resets the number of respins to 4\",\n  \"CR_BG_EACH_SYMBOL_RESET_RESPINS\": \"Each new symbol appearing on the reels resets the number of respins to 3\",\n  \"CR_BG_FEATURES_TRANSFER\": \"Activated FEATURES are transfered to a bonus game, where they provide corresponding boosters\",\n  \"CR_BG_FREE_SPINS_VALUES\": \"Possible values of the FREE SPINS Symbol: {free_spins_values}\",\n  \"CR_BG_MONEY_VALUES\": \"Possible values of the MONEY Symbol: {money_values}\",\n  \"CR_BG_MULTI_FEATURE_VALUES\": \"Possible values of the MULTI FEATURE: {multiplier_values}\",\n  \"CR_BG_MULTIPLIER_VALUES\": \"Possible values of the MULTIPLIER Symbol: {multiplier_values}\",\n  \"CR_BG_ONLY_BONUS_SYMBOLS\": \"Only BONUS symbols appear on the reels during the Bonus Game\",\n  \"CR_BG_PLAY_TRIGGERED_BET\": \"The Bonus Game is played at the triggering bet\",\n  \"CR_BG_STICKY_VALUES\": \"Possible values of the STICKY BONUS Symbol: {sticky_values} X #PAYTABLE_TB_FULL\",\n  \"CR_BG_SUMS_SYMBOLS_VALUES_IN_THE_END\": \"When the Bonus Game ends, the values of all symbols are summed up and a Bonus Win is paid\",\n  \"CR_BG_SUMS_VALUES_IN_THE_END\": \"When the Bonus Game ends, the values of all BONUS symbols are summed up and a Bonus Win is paid\",\n  \"CR_BG_SUPER_BALL_VALUES\": \"Possible values of the SUPER BONUS Symbol: {super_ball_values} X #PAYTABLE_TB_FULL\",\n  \"CR_BG_TRIGGERED_IN_FS_SAME_BET\": \"The Bonus Game that triggered in Free Spins is played at the Free Spins triggering bet\",\n  \"CR_BONUS_GAME\": \"Bonus Game\",\n  \"CR_BOOST_FEATURE\": \"BOOST FEATURE\",\n  \"CR_BUTTONS\": \"Keys\",\n  \"CR_BUTTONS_KEYS\": \"You can also start the spin by pressing the \\\"Enter\\\" or \\\"Space\\\" keys on the keyboard\",\n  \"CR_BUTTONS_TURBO\": \"You can also start the turbo spin by holding the \\\"Enter\\\" or \\\"Space\\\" keys on the keyboard\",\n  \"CR_COLLAPSING_SYMBOLS\": \"Collapsing Symbols\",\n  \"CR_COLLECT_SYMBOL\": \"Collect Symbol\",\n  \"CR_CS_CONTINUE_TILL_NO_WIN\": \"The cascade continues until no more winning combinations are available\",\n  \"CR_CS_REPLACED_RANDOM_SYMBOLS\": \"Collapsed symbols will be replaced by random symbols during a cascade\",\n  \"CR_CS_SCATTER_NOT_COLLAPSE\": \"SCATTER symbols cannot collapse\",\n  \"CR_EACH_BS_CAN_TRIGGER\": \"Each BONUS symbol has a chance to trigger a Bonus Game\",\n  \"CR_EBG_ANY_BONUS_LANDING\": \"Each bonus symbol of any type landing on the reels increases the trigger chance of the extra Bonus Game\",\n  \"CR_EBG_BONUS_JACKPOT_LANDING_CENTRAL_ROW\": \"BONUS and JACKPOT symbols that land on the central row increase the trigger chance of the extra Bonus Game\",\n  \"CR_EBG_TRIGGER_MG\": \"The Extra Bonus Game can be triggered during the Main Game only\",\n  \"CR_EBG_TRIGGER_MG_FS\": \"The Extra Bonus Game can be triggered during the main game or Free Spins\",\n  \"CR_EXTRA_BONUS_GAME\": \"Extra Bonus Game\",\n  \"CR_FREE_SPINS\": \"Free Spins\",\n  \"CR_FS_CAN_RETRIGGER\": \"Free Spins can be retriggered\",\n  \"CR_FS_LINES_NUMBER_FIXED\": \"The number of lines in the Free Spins mode is identical to the number in the Base game mode\",\n  \"CR_FS_NO_SCATTER_SYMBOL\": \"The SCATTER symbol will not appear during Free Spins\",\n  \"CR_FS_NOT_RETRIGGER\": \"Free Spins cannot be retriggered\",\n  \"CR_FS_PLAY_AVERAGE_BET\": \"Free Spins are played at the average bet\",\n  \"CR_FS_PLAY_TRIGGERED_BET\": \"Free Spins are played at the triggering bet\",\n  \"CR_FS_WAYS_NUMBER_FIXED\": \"The number of ways in the Free Spins mode is identical to the number in the Base game mode\",\n  \"CR_GENERAL\": \"General\",\n  \"CR_GENERAL_DYNAMIC_PAYTABLE\": \"The paytable is dynamic and displays payout values depending on the selected bet\",\n  \