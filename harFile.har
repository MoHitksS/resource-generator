          "content": {
            "size": 45072,
            "mimeType": "application/json",
            "text": "{\n  \"AWARD_AMOUNT_PRIZE\": \"<i>Prize: {prize}​</i>\",\n  \"AWARD_FOR_GP_TOURNAMENT\": \"Tournament of game Provider\",\n  \"AWARD_FOR_TOURNAMENT\": \"Tournament\",\n  \"AWARD_FOR_TOURNAMENT_TITLE\": \"You took {player_place} place in {tournament_name}\",\n  \"AWARD_FOR_TOURNAMENTS_TITLE_PLAYER_PRIZE\": \"You won {player_prize}!\",\n  \"AWARD_FOR_TOURNAMENTS_TITLE_PLAYER_PRIZE_INFO\": \"You will get the prize within {payment_period} hours\",\n  \"AWARD_PLACE\": \"{place} Place\",\n  \"AWARD_PLACED_BET\": \"<i>Bet: {bet} |</i>\",\n  \"AWARD_TOTAL_BET_MULTIPLIER\": \"{bet_multiplier} <span>​{placed_bet} {amount}​</span>\",\n  \"AWARDS_AWAILIBLE_TILL_TEXT\": \"Available till {time}.\",\n  \"AWARDS_BASE_TEXT\": \"{amount}\",\n  \"AWARDS_BASE_TEXT_CUSTOM\": \"You won a souvenir.\",\n  \"AWARDS_BUTTON_CONTINUE_TEXT\": \"OK\",\n  \"AWARDS_BUTTON_OK_TEXT\": \"Collect\",\n  \"AWARDS_COLLECT_TILL_TEXT\": \"Pick it up before {time}.\",\n  \"AWARDS_CONTENT_TEXT\": \"Free Bets are available in\",\n  \"BUTTON_BACK_TEXT\": \"Back\",\n  \"BUTTON_RULES_TEXT\": \"Rules\",\n  \"COUNTDOWN_DAYS\": \"d\",\n  \"COUNTDOWN_HOURS\": \"h\",\n  \"COUNTDOWN_MINUTES\": \"m\",\n  \"COUNTDOWN_SECONDS\": \"s\",\n  \"COUNTER_DAYS\": \"d.\",\n  \"COUNTER_HOURS\": \"h.\",\n  \"COUNTER_MINUTES\": \"m.\",\n  \"COUNTER_SECONDS\": \"s.\",\n  \"DAILY_AVAILABLE_GAMES_ALL\": \"Available in: <span>all Provider games</span>\",\n  \"DAILY_AVAILABLE_GAMES_ALL_EXCEPT\": \"Available in: <span>all Provider games (except {games_blacklist})</span>\",\n  \"DAILY_BUTTON_CONTINUE\": \"#TOURNAMENTS_BUTTON_CONTINUE\",\n  \"DAILY_BUTTON_PLAY_NOW\": \"#TOURNAMENTS_BUTTON_PLAY_NOW\",\n  \"DAILY_CLAIM_TEXT\": \"Claim\",\n  \"DAILY_GOAL_GET\": \"Get {count}\",\n  \"DAILY_GOAL_MAKE_BET\": \"Bet\\n{count} total\\n<b>Get\\n{prize}​<b>\",\n  \"DAILY_GOAL_PRIZE_FEATURE_FREESPINS\": \"Bonus game\",\n  \"DAILY_GOAL_PRIZE_FREEBET\": \"{count} FB\",\n  \"DAILY_GOAL_PROGRESS\": \"Progress\",\n  \"DAILY_MINI_WIDGET_ALL_COMPLETED\": \"Continues in:\",\n  \"DAILY_MINI_WIDGET_CAMPAIGN\": \"Campaign\",\n  \"DAILY_MINI_WIDGET_IS_OVER\": \"is over\",\n  \"DAILY_MINI_WIDGET_LAST_DAY\": \"Ends in:\",\n  \"DAILY_MINI_WIDGET_STARTS_IN\": \"#DAILY_WIDGET_STARTS_IN\",\n  \"DAILY_POPUP_PRIZE_POOL\": \"#TOURNAMENTS_POPUP_PRIZE_POOL\",\n  \"DAILY_POST_POPUP_DESCRIPTION\": \"#DAILY_POST_POPUP_TEXT1\\n#DAILY_POST_POPUP_TEXT2\\n#DAILY_POST_POPUP_TEXT3\",\n  \"DAILY_POST_POPUP_PRIZE\": \"Campaign is over\",\n  \"DAILY_POST_POPUP_TEXT1\": \"Thanks for your participation!\",\n  \"DAILY_POST_POPUP_TEXT2\": \"This campaign is now finished, therefore no further player's actions will participate in the Rewards calculation\",\n  \"DAILY_POST_POPUP_TEXT3\": \"All uncollected Rewards are not transferable to the next day\",\n  \"DAILY_POST_POPUP_TITLE\": \"Daily Rewards Campaign\",\n  \"DAILY_PRE_POPUP_BUTTON\": \"CONTINUE\",\n  \"DAILY_PRE_POPUP_DESCRIPTION\": \"#DAILY_PRE_POPUP_TEXT1\\n{available_in}\",\n  \"DAILY_PRE_POPUP_ENDS_IN\": \"#TOURNAMENTS_TITLE_ENDS_IN\",\n  \"DAILY_PRE_POPUP_PRIZE\": \"Guaranteed Personal Rewards\",\n  \"DAILY_PRE_POPUP_STARTS_IN\": \"Starts in:\",\n  \"DAILY_PRE_POPUP_TEXT1\": \"Play every day & Increase your reward!\",\n  \"DAILY_PRE_POPUP_TITLE\": \"Daily Rewards Campaign\",\n  \"DAILY_REWARDS_TITLE\": \"#DAILY_TITLE\",\n  \"DAILY_RULES\": \"1. #DAILY_RULES_TEXT1\\n1. #DAILY_RULES_TEXT2\\n1. #DAILY_RULES_TEXT3\\n1. #DAILY_RULES_TEXT4\\n1. #DAILY_RULES_TEXT5\\n1. #DAILY_RULES_TEXT6\\n1. #DAILY_RULES_TEXT7\\n1. #DAILY_RULES_TEXT8\\n1. #DAILY_RULES_TEXT9\\n1. #DAILY_RULES_TEXT10\\n1. #DAILY_RULES_TEXT11\\n1. #DAILY_RULES_TEXT12\\n1. #DAILY_RULES_TEXT13\\n1. #DAILY_RULES_TEXT14\\n1. #DAILY_RULES_TEXT15\\n1. #DAILY_RULES_TEXT16\",\n  \"DAILY_RULES_TEXT1\": \"Only real money rounds are able to participate in daily Rewards\",\n  \"DAILY_RULES_TEXT10\": \"In order to claim your reward, you need to press the “Claim” button if it is active and you have unclaimed prizes inside the campaign window\",\n  \"DAILY_RULES_TEXT11\": \"All rewards are active and available to claim and collect during the calendar day they were received, if no other conditions are stated\",\n  \"DAILY_RULES_TEXT12\": \"The provider holds the right to a final decision for the true and right interpretation of any Terms & Conditions, tasks and rewards in arguable situations\",\n  \"DAILY_RULES_TEXT13\": \"Daily Rewards Terms & Conditions could be changed at any time\",\n  \"DAILY_RULES_TEXT14\": \"Malfunction voids all pays\",\n  \"DAILY_RULES_TEXT15\": \"By participating in Daily Rewards you automatically agree to the Terms and Conditions outlined here and to the ones which the operator provides\",\n  \"DAILY_RULES_TEXT16\": \"In cases of emergency, the Provider holds the right to cancel Daily Rewards for an indefinite term without any payments for prizes according to cancellation\",\n  \"DAILY_RULES_TEXT2\": \"Other than the price to make a spin, there is no additional cost to participate in the promo\",\n  \"DAILY_RULES_TEXT3\": \"Daily Rewards campaign runs between **​{start_time}​** and **​{end_time}​**\",\n  \"DAILY_RULES_TEXT4\": \"The Daily Rewards campaign contains cycles of **​{days_count} calendar days** (start and end of the day UTC +0)\",\n  \"DAILY_RULES_TEXT5\": \"You can complete the daily task up to **​{goals_count} times**\",\n  \"DAILY_RULES_TEXT6\": \"Rewards grow with daily progression and also grow inside each day with each task completion\",\n  \"DAILY_RULES_TEXT7\": \"You must complete the daily task at least once in order to save your daily progress\",\n  \"DAILY_RULES_TEXT8\": \"If the daily task isn't completed, progression and cycle will reset to day one\",\n  \"DAILY_RULES_TEXT9\": \"The Daily Rewards campaign will end on **​{end_time}​** regardless of the current cycle day\",\n  \"DAILY_RULES_TITLE\": \"Rules\",\n  \"DAILY_START_POPUP_BUTTON\": \"PLAY NOW\",\n  \"DAILY_START_POPUP_DESCRIPTION\": \"#DAILY_START_POPUP_TEXT1\\n#DAILY_START_POPUP_TEXT2\\n#DAILY_START_POPUP_TEXT3\\n#DAILY_START_POPUP_TEXT4\\n#DAILY_START_POPUP_TEXT5\\n{available_in}\",\n  \"DAILY_START_POPUP_PRIZE\": \"Guaranteed personal rewards\",\n  \"DAILY_START_POPUP_TEXT1\": \"Play every day & Increase your reward!\",\n  \"DAILY_START_POPUP_TEXT2\": \"Instant Rewards for a completed Daily Goal\",\n  \"DAILY_START_POPUP_TEXT3\": \"Come back every day to save progress and get more\",\n  \"DAILY_START_POPUP_TEXT4\": \"Reach the <span>​{day}​</span> day for the biggest Reward\",\n  \"DAILY_START_POPUP_TEXT5\": \"up to <span>​{max_rewards}​</span> Rewards a day!\",\n  \"DAILY_START_POPUP_TITLE\": \"Daily Rewards Campaign\",\n  \"DAILY_SUBTITLE\": \"Come back every day to save progress and win more!\",\n  \"DAILY_TIME_LEFT\": \"{hours}​h:​{minutes}​m\",\n  \"DAILY_TITLE\": \"Daily Rewards\",\n  \"DAILY_TODAY_TEXT\": \"Today\",\n  \"DAILY_TOMORROW_TEXT\": \"Tomorrow\",\n  \"DAILY_WIDGET_CLAIM_TIMER\": \"Expires in:\",\n  \"DAILY_WIDGET_COMPLETED\": \"Completed\",\n  \"DAILY_WIDGET_DAY_FINISHES\": \"Day ends in:\",\n  \"DAILY_WIDGET_GOAL\": \"Goal\",\n  \"DAILY_WIDGET_MORE_INFO\": \"More info\",\n  \"DAILY_WIDGET_NEXT_DAY\": \"Next day starts in:\",\n  \"DAILY_WIDGET_NEXT_PRIZE\": \"Next prize\",\n  \"DAILY_WIDGET_OVER\": \"Campaign is over\",\n  \"DAILY_WIDGET_READY_TO_CLAIM\": \"Ready to claim\",\n  \"DAILY_WIDGET_STARTS_IN\": \"Starts in:\",\n  \"DAILY_WIDGET_TITLE\": \"Daily Rewards\",\n  \"DIALOG_FREEBETS_CHOOSE\": \"Free Bets\",\n  \"DIALOG_FREEBETS_CONTINUE\": \"You have {0} Free Bets.\\nGood luck!\",\n  \"DIALOG_FREEBETS_FEATURE_FREESPIN_INTRO\": \"<span>FreeSpin Feature with </span>\\n<b>​{0} Total Bet</b>\",\n  \"DIALOG_FREEBETS_FEATURE_FREESPIN_INTRO_SHORT\": \"{0} Feature\",\n  \"DIALOG_FREEBETS_FINISHED_NO_WIN\": \"Better luck next time\",\n  \"DIALOG_FREEBETS_FINISHED_PLAYER_PRIZE_INFO\": \"You will get the prize within {payment_period} hours\",\n  \"DIALOG_FREEBETS_GRANTED\": \"{total_rounds} FB × {total_bet} {amount}\",\n  \"DIALOG_FREEBETS_GRANTED_SHORT\": \"{total_rounds} Free Bets\",\n  \"DIALOG_PROCEED_TEXT\": \"Press the button to continue\",\n  \"ERROR_AWARD_EXCEED\": \"Sorry, your award is currently unavailable.\\nPlease contact support for more information.\",\n  \"FLIP_TO_WIN_BOARD\": \"Board\",\n  \"FLIP_TO_WIN_BUTTON_CONTINUE\": \"Continue\",\n  \"FLIP_TO_WIN_BUTTON_PLAY_NOW\": \"Play now\",\n  \"FLIP_TO_WIN_CAMPAIGN_IS_OVER\": \"Campaign is over\",\n  \"FLIP_TO_WIN_DEFAULT_DESCRIPTION\": \"#FLIP_TO_WIN_DEFAULT_DESCRIPTION_1\\n#FLIP_TO_WIN_DEFAULT_DESCRIPTION_2\\n#FLIP_TO_WIN_DEFAULT_DESCRIPTION_3\\n#FLIP_TO_WIN_DEFAULT_DESCRIPTION_4\\n#FLIP_TO_WIN_DEFAULT_DESCRIPTION_5\\n#FLIP_TO_WIN_DEFAULT_DESCRIPTION_6\\n#FLIP_TO_WIN_DEFAULT_DESCRIPTION_7\\n#FLIP_TO_WIN_DEFAULT_DESCRIPTION_8\\n#FLIP_TO_WIN_DEFAULT_DESCRIPTION_9\\n#FLIP_TO_WIN_DEFAULT_DESCRIPTION_10\\n#FLIP_TO_WIN_DEFAULT_DESCRIPTION_11\\n#FLIP_TO_WIN_DEFAULT_DESCRIPTION_12\\n#FLIP_TO_WIN_DEFAULT_DESCRIPTION_13\\n#FLIP_TO_WIN_DEFAULT_DESCRIPTION_14\",\n  \"FLIP_TO_WIN_DEFAULT_DESCRIPTION_1\": \"Only real mode rounds are able to participate in <span>#FLIP_TO_WIN_TITLE</span>.\",\n  \"FLIP_TO_WIN_DEFAULT_DESCRIPTION_10\": \"Players will get prizes within {payment_period} hours after the end of the #FLIP_TO_WIN_TITLE.\",\n  \"FLIP_TO_WIN_DEFAULT_DESCRIPTION_11\": \"The #FLIP_TO_WIN_TITLE campaign rules can be changed anytime.\",\n  \"FLIP_TO_WIN_DEFAULT_DESCRIPTION_12\": \"Malfunction voids all pays.\",\n  \"FLIP_TO_WIN_DEFAULT_DESCRIPTION_13\": \"By participating in the #FLIP_TO_WIN_TITLE campaign you automatically agree to the Terms and Conditions outlined here and the rules established by the operator.\",\n  \"FLIP_TO_WIN_DEFAULT_DESCRIPTION_14\": \"The provider holds the right to cancel the #FLIP_TO_WIN_TITLE campaign for an indefinite term without any payments according to the leaderboard in cases of emergency.\",\n  \"FLIP_TO_WIN_DEFAULT_DESCRIPTION_2\": \"#FLIP_TO_WIN_TITLE participating games: <span>​{games_list}​</span>.\",\n  \"FLIP_TO_WIN_DEFAULT_DESCRIPTION_3\": \"The #FLIP_TO_WIN_TITLE campaign runs between <span>​{start_time}​</span> <span>​{end_time}​</span>.\",\n  \"FLIP_TO_WIN_DEFAULT_DESCRIPTION_4\": \"In order to get the 1st flip, you have to make {rounds_count_first} spins. In order to get the 2nd flip, you have to make {rounds_count_second} spins. In order to get the 3rd flip, you have to make {rounds_count_third} spins.\",\n  \"FLIP_TO_WIN_DEFAULT_DESCRIPTION_5\": \"To get one flip, you have to make the <span>required number of spins</span> using the same bet size.\",\n  \"FLIP_TO_WIN_DEFAULT_DESCRIPTION_6\": \"Progress will be saved for each bet size.\",\n  \"FLIP_TO_WIN_DEFAULT_DESCRIPTION_7\": \"If you received an option to Flip on a specific bet, your progress won't increase for this bet until you <span>claim</span> the prize.\",\n  \"FLIP_TO_WIN_DEFAULT_DESCRIPTION_8\": \"There are no additional costs to enter the #FLIP_TO_WIN_TITLE campaign.\",\n  \"FLIP_TO_WIN_DEFAULT_DESCRIPTION_9\": \"Only finished spins will be counted to #FLIP_TO_WIN_TITLE progress.\",\n  \"FLIP_TO_WIN_DEFAULT_RULES\": \"1. #FLIP_TO_WIN_DEFAULT_RULES_1\\n1. #FLIP_TO_WIN_DEFAULT_RULES_2\\n1. #FLIP_TO_WIN_DEFAULT_RULES_3\\n1. #FLIP_TO_WIN_DEFAULT_RULES_4\\n1. #FLIP_TO_WIN_DEFAULT_RULES_5\\n1. #FLIP_TO_WIN_DEFAULT_RULES_6\\n1. #FLIP_TO_WIN_DEFAULT_RULES_7\\n1. #FLIP_TO_WIN_DEFAULT_RULES_8\\n1. #FLIP_TO_WIN_DEFAULT_RULES_9\\n1. #FLIP_TO_WIN_DEFAULT_RULES_10\\n1. #FLIP_TO_WIN_DEFAULT_RULES_11\\n1. #FLIP_TO_WIN_DEFAULT_RULES_12\\n1. #FLIP_TO_WIN_DEFAULT_RULES_13\\n1. #FLIP_TO_WIN_DEFAULT_RULES_14\",\n  \"FLIP_TO_WIN_DEFAULT_RULES_1\": \"Only real mode rounds are able to participate in **#FLIP_TO_WIN_TITLE**.\",\n  \"FLIP_TO_WIN_DEFAULT_RULES_10\": \"Players will get prizes within {payment_period} hours after the end of the #FLIP_TO_WIN_TITLE.\",\n  \"FLIP_TO_WIN_DEFAULT_RULES_11\": \"The #FLIP_TO_WIN_TITLE campaign rules can be changed anytime.\",\n  \"FLIP_TO_WIN_DEFAULT_RULES_12\": \"Malfunction voids all pays.\",\n  \"FLIP_TO_WIN_DEFAULT_RULES_13\": \"By participating in the #FLIP_TO_WIN_TITLE campaign you automatically agree to the Terms and Conditions outlined here and the rules established by the operator.\",\n  \"FLIP_TO_WIN_DEFAULT_RULES_14\": \"Provider holds the right to cancel the #FLIP_TO_WIN_TITLE campaign for an indefinite term without any payments according to the leaderboard in cases of emergency.\",\n  \"FLIP_TO_WIN_DEFAULT_RULES_2\": \"#FLIP_TO_WIN_TITLE participating games: **​{games_list}​**.\",\n  \"FLIP_TO_WIN_DEFAULT_RULES_3\": \"The #FLIP_TO_WIN_TITLE campaign runs between **​{start_time}​** **​{end_time}​**.\",\n  \"FLIP_TO_WIN_DEFAULT_RULES_4\": \"In order to get the 1st flip, you have to make {rounds_count_first} spins. In order to get the 2nd flip, you have to make {rounds_count_second} spins. In order to get the 3rd flip, you have to make {rounds_count_third} spins.\",\n  \"FLIP_TO_WIN_DEFAULT_RULES_5\": \"To get one flip, you have to make the **required number of spins** using the same bet size.\",\n  \"FLIP_TO_WIN_DEFAULT_RULES_6\": \"Progress will be saved for each bet size.\",\n  \"FLIP_TO_WIN_DEFAULT_RULES_7\": \"If you received an option to Flip on a specific bet, your progress won't increase for this bet until you **claim** the prize.\",\n  \"FLIP_TO_WIN_DEFAULT_RULES_8\": \"There are no additional costs to enter the #FLIP_TO_WIN_TITLE campaign.\",\n  \"FLIP_TO_WIN_DEFAULT_RULES_9\": \"Only finished spins will be counted towards the #FLIP_TO_WIN_TITLE progress.\",\n  \"FLIP_TO_WIN_GAMES_ALL\": \"all supported games\",\n  \"FLIP_TO_WIN_GAMES_ALL_EXCEPT\": \"all supported games (except {games_blacklist})\",\n  \"FLIP_TO_WIN_GAMES_ALL_EXCEPT_SHORT\": \"#FLIP_TO_WIN_GAMES_ALL*\",\n  \"FLIP_TO_WIN_MENU_BACK_TO_GAME\": \"Back to game\",\n  \"FLIP_TO_WIN_MENU_CHANCES_LEFT\": \"Chances left: {chances_left_number}\",\n  \"FLIP_TO_WIN_MENU_CURRENT_WIN\": \"Current win:\",\n  \"FLIP_TO_WIN_MENU_PROGRESS_ON_BET\": \"Progress on **​{current_total_bet}​** Bet\",\n  \"FLIP_TO_WIN_NEXT_ROUND\": \"Next round\",\n  \"FLIP_TO_WIN_POPUP_TOTAL_BETS\": \"{total_bet_multiplier} Total Bets!\",\n  \"FLIP_TO_WIN_POPUP_WIN_UP_TO\": \"Win up to\",\n  \"FLIP_TO_WIN_READY_TO_FLIP\": \"Ready to flip!\",\n  \"FLIP_TO_WIN_RULES_TITLE\": \"Rules\",\n  \"FLIP_TO_WIN_TIME_LEFT\": \"Time left:\",\n  \"FLIP_TO_WIN_TITLE\": \"Flip To Win\",\n  \"FLIP_TO_WIN_TITLE_ENDS_IN\": \"Ends in:\",\n  \"FLIP_TO_WIN_TITLE_STARTS_IN\": \"Starts in:\",\n  \"FREEBETS_FINISHED\": \"Free Bets finished\",\n  \"INFO_TITLE_FROM\": \"from\",\n  \"INFO_TITLE_TO\": \"to\",\n  \"JACKPOTS_ADDITIONAL_BEFORE\": \"Must pay before\",\n  \"JACKPOTS_ADDITIONAL_IN\": \"Pays in\",\n  \"JACKPOTS_CARD_LARGEST_WIN\": \"Largest Win\",\n  \"JACKPOTS_CARD_LAST_WIN\": \"Last Win\",\n  \"JACKPOTS_CARD_NUMBER_OF_WINNERS\": \"Number of Winners\",\n  \"JACKPOTS_CLASSIC_JACKPOT_GRAND_TITLE\": \"Grand Jackpot\",\n  \"JACKPOTS_CLASSIC_JACKPOT_MAJOR_TITLE\": \"Major Jackpot\",\n  \"JACKPOTS_CLASSIC_JACKPOT_MINI_TITLE\": \"Mini Jackpot\",\n  \"JACKPOTS_CLASSIC_JACKPOT_MINOR_TITLE\": \"Minor Jackpot\",\n  \"JACKPOTS_CLASSIC_JACKPOT_TITLE\": \"Classic Jackpot\",\n  \"JACKPOTS_DESCRIPTION_1\": \"<span>Time jackpot</span> is triggered randomly after the player has made a bet and must be won by a specific time.\\n</br>Сloser to the end of the countdown timer, the chances of winning increase.\",\n  \"JACKPOTS_DESCRIPTION_2\": \"<span>Classic Jackpot</span> is triggered randomly and can be won by any player.\",\n  \"JACKPOTS_DESCRIPTION_3\": \"<span>Must Drop Jackpot</span> is triggered randomly after the player has made a bet and is guaranteed to pay before reaching the maximum amount.\\n</br>The chances of winning increase as the counter gets closer to the maximum amount.\",\n  \"JACKPOTS_LAST_WINNERS\": \"Last winners\",\n  \"JACKPOTS_MUST_DROP_JACKPOT_TITLE\": \"Must Drop\",\n  \"JACKPOTS_NAME\": \"Royal Jackpots\",\n  \"JACKPOTS_RULES\": \"1. #JACKPOTS_RULES_1\\n1. #JACKPOTS_RULES_4\\n1. #JACKPOTS_RULES_5\\n1. #JACKPOTS_RULES_6\\n1. #JACKPOTS_RULES_7\\n1. #JACKPOTS_RULES_8\\n1. #JACKPOTS_RULES_9\\n1. #JACKPOTS_RULES_10\\n1. #JACKPOTS_RULES_11\\n1. #JACKPOTS_RULES_12\\n1. #JACKPOTS_RULES_13\\n1. #JACKPOTS_RULES_14\\n1. #JACKPOTS_RULES_15\\n1. #JACKPOTS_RULES_16\\n1. #JACKPOTS_RULES_17\\n1. #JACKPOTS_RULES_18\\n1. #JACKPOTS_RULES_19\\n1. #JACKPOTS_RULES_20\\n1. #JACKPOTS_RULES_21\\n1. #JACKPOTS_RULES_22\",\n  \"JACKPOTS_RULES_1\": \"Any player has a chance to win the **#JACKPOTS_NAME**!\",\n  \"JACKPOTS_RULES_10\": \"Each bet contributes a small share to the Jackpot pool and is allocated between all types of **#JACKPOTS_NAME**.\",\n  \"JACKPOTS_RULES_11\": \"Bet contribution is split into 2 pots: one part of bet contribution is gradually increasing the current **#JACKPOTS_NAME**, and the other part is used to accumulate the seed value of the next **#JACKPOTS_NAME**.\",\n  \"JACKPOTS_RULES_12\": \"The Jackpot counter is reset to the Jackpot seed value, when one type of **#JACKPOTS_NAME** is won.\",\n  \"JACKPOTS_RULES_13\": \"No symbol combinations resulting after player's spin affects the winning of **#JACKPOTS_NAME**. Spinning the reels for real money is the only way to randomly trigger the **#JACKPOTS_NAME**!\",\n  \"JACKPOTS_RULES_14\": \"**#JACKPOTS_NAME** wins always come in the player's account currency.\",\n  \"JACKPOTS_RULES_15\": \"If the player's currency is different from the **#JACKPOTS_NAME** currency, the winnings are paid in the player's currency in accordance with the exchange rate.\",\n  \"JACKPOTS_RULES_16\": \"The daily updated exchange rate is based on an external independent source and corresponds to the one set on the **#JACKPOTS_NAME** server.\",\n  \"JACKPOTS_RULES_17\": \"All players participating in **#JACKPOTS_NAME** will receive a notification when the **#JACKPOTS_NAME** is won by any other player.\",\n  \"JACKPOTS_RULES_18\": \"The **#JACKPOTS_NAME** can be won only during the main game.\",\n  \"JACKPOTS_RULES_19\": \"The **#JACKPOTS_NAME** is not available in demo mode.\",\n  \"JACKPOTS_RULES_20\": \"The same **#JACKPOTS_NAME** cannot be claimed by two or more players at the same time.\",\n  \"JACKPOTS_RULES_21\": \"Internet connection issues can lead to delays in notifications or updates of **#JACKPOTS_NAME** counters, but they do not affect the **#JACKPOTS_NAME** actual winnings.\",\n  \"JACKPOTS_RULES_22\": \"Malfunction voids all pays and plays.\",\n  \"JACKPOTS_RULES_4\": \"All bets made with real money take part in the **#JACKPOTS_NAME** drawing.\",\n  \"JACKPOTS_RULES_5\": \"**#JACKPOTS_NAME** are a separate promotional tool working independently of a game's features.\",\n  \"JACKPOTS_RULES_6\": \"There are 3 types of **#JACKPOTS_NAME**: Time, Classic (mini, minor, major and grand) and Must Drop. Each of them is presented with an individual title and position on the Jackpot widget panel when activated in a game.\",\n  \"JACKPOTS_RULES_7\": \"**Time Jackpot** is triggered randomly after the player has made a bet and must be won by a specific time. **Time Jackpot** has a time limit and the closer the countdown is to running out of time, the higher the chances of winning the **Time Jackpot**. The winnings are guaranteed to be paid before **Time Jackpot** countdown timer runs out. In case the countdown timer runs out, the Jackpot will be triggered with the next bet placed on the server.\",\n  \"JACKPOTS_RULES_8\": \"The **Must Drop Jackpot** is triggered randomly after a player has made a bet and is guaranteed to pay before reaching the maximum amount shown by the counter. The chance of winning the **Must Drop Jackpot** increases when the **Must Drop Jackpot** counter gets closer to the maximum amount. In case the Must Drop counter reaches the end, the Jackpot will be triggered with the next bet placed on the server.\",\n  \"JACKPOTS_RULES_9\": \"The **Classic Jackpot** is triggered randomly and can be won by any player.\",\n  \"JACKPOTS_RULES_TITLE\": \"Rules\",\n  \"JACKPOTS_TIME_JACKPOT_TITLE\": \"Time Jackpot\",\n  \"JACKPOTS_TITLE\": \"Jackpots\",\n  \"JACKPOTS_TOTAL_WIN\": \"Total win\",\n  \"JACKPOTS_WINNERS_AMOUNT\": \"Amount\",\n  \"JACKPOTS_WINNERS_JP\": \"JP\",\n  \"JACKPOTS_WINNERS_TIME\": \"Time\",\n  \"JACKPOTS_WINNERS_WINNER\": \"Winner\",\n  \"OPT_OUT_BUTTON\": \"Opt Out\",\n  \"OPT_OUT_CONFIRM\": \"Are you sure?\",\n  \"OPT_OUT_CONFIRM_NO\": \"No\",\n  \"OPT_OUT_CONFIRM_YES\": \"Yes\",\n  \"OPT_OUT_MESSAGE\": \"You opted out\",\n  \"OPT_OUT_UNDO_BUTTON\": \"UNDO\",\n  \"PRIZE_DROP_ALL_WINS\": \"All Wins\",\n  \"PRIZE_DROP_BUTTON_CONTINUE\": \"Continue\",\n  \"PRIZE_DROP_BUTTON_PLAY_NOW\": \"Play now\",\n  \"PRIZE_DROP_CAMPAIGN\": \"Campaign\",\n  \"PRIZE_DROP_CAMPAIGN_IS_OVER\": \"Campaign is over\",\n  \"PRIZE_DROP_DEFAULT_DESCRIPTION_POST_NOTIFICATION\": \"#PRIZE_DROP_DEFAULT_TITLE runs between <span>​{start_time}​</span> and <span>​{end_time}​</span>\\nAvailable in: <span>​{games_list_short}​</span>\\nThe minimum bet required to take part in #PRIZE_DROP_DEFAULT_TITLE is <span>​{min_bet}​</span>\\nNo additional payments are needed, only the spin cost is required in order to get a #PRIZE_DROP_DEFAULT_TITLE chance\",\n  \"PRIZE_DROP_DEFAULT_DESCRIPTION_PRE_NOTIFICATION\": \"#PRIZE_DROP_DEFAULT_TITLE runs between <span>​{start_time}​</span> and <span>​{end_time}​</span>\\nAvailable in: <span>​{games_list_short}​</span>\\nThe minimum bet required to take part in #PRIZE_DROP_DEFAULT_TITLE is <span>​{min_bet}​</span>\\nNo additional payments are needed, only the spin cost is required in order to get a #PRIZE_DROP_DEFAULT_TITLE chance\",\n  \"PRIZE_DROP_DEFAULT_DESCRIPTION_STARTED\": \"#PRIZE_DROP_DEFAULT_TITLE runs between <span>​{start_time}​</span> and <span>​{end_time}​</span>\\nAvailable in: <span>​{games_list_short}​</span>\\nThe minimum bet required to take part in #PRIZE_DROP_DEFAULT_TITLE is <span>​{min_bet}​</span>\\nNo additional payments are needed, only the spin cost is required in order to get a #PRIZE_DROP_DEFAULT_TITLE chance\",\n  \"PRIZE_DROP_DEFAULT_RULES\": \"1. #PRIZE_DROP_DEFAULT_RULES_1\\n1. #PRIZE_DROP_DEFAULT_RULES_2\\n1. #PRIZE_DROP_DEFAULT_RULES_3\\n1. #PRIZE_DROP_DEFAULT_RULES_4\\n1. #PRIZE_DROP_DEFAULT_RULES_5\\n1. #PRIZE_DROP_DEFAULT_RULES_6\\n1. #PRIZE_DROP_DEFAULT_RULES_7\\n1. #PRIZE_DROP_DEFAULT_RULES_8\\n1. #PRIZE_DROP_DEFAULT_RULES_9\\n1. #PRIZE_DROP_DEFAULT_RULES_10\\n1. #PRIZE_DROP_DEFAULT_RULES_11\\n1. #PRIZE_DROP_DEFAULT_RULES_12\",\n  \"PRIZE_DROP_DEFAULT_RULES_1\": \"Only real mode rounds are able to participate in #PRIZE_DROP_DEFAULT_TITLE.\",\n  \"PRIZE_DROP_DEFAULT_RULES_10\": \"Malfunction voids all pays.\",\n  \"PRIZE_DROP_DEFAULT_RULES_11\": \"By participating in #PRIZE_DROP_DEFAULT_TITLE campaign you automatically agree to the Terms and Conditions outlined here and the rules established by the operator.\",\n  \"PRIZE_DROP_DEFAULT_RULES_12\": \"The provider holds the right to cancel the #PRIZE_DROP_DEFAULT_TITLE campaign for an indefinite term without any payments according to the leaderboard in cases of emergency.\",\n  \"PRIZE_DROP_DEFAULT_RULES_13\": \"The chance to win a prize increases when the campaign moves to the status of the Hot Period.\",\n  \"PRIZE_DROP_DEFAULT_RULES_2\": \"#PRIZE_DROP_DEFAULT_TITLE participating games: **​{games_list}​**.\",\n  \"PRIZE_DROP_DEFAULT_RULES_3\": \"#PRIZE_DROP_DEFAULT_TITLE campaign runs between **​{start_time}​** **​{end_time}​** or when there are no more prizes left.\",\n  \"PRIZE_DROP_DEFAULT_RULES_4\": \"Each player will get personal #PRIZE_DROP_DEFAULT_TITLE ID for the #PRIZE_DROP_DEFAULT_TITLE leaderboard.\",\n  \"PRIZE_DROP_DEFAULT_RULES_5\": \"The minimum bet required to take part in the #PRIZE_DROP_DEFAULT_TITLE campaign is **​{min_bet}​**.\",\n  \"PRIZE_DROP_DEFAULT_RULES_6\": \"There are no additional costs to enter the #PRIZE_DROP_DEFAULT_TITLE campaign.\",\n  \"PRIZE_DROP_DEFAULT_RULES_7\": \"The random #PRIZE_DROP_DEFAULT_TITLE rules and prize tables are built in the participating games. The prize table updates in real time, showing the current standings as well as how many prizes are left.\",\n  \"PRIZE_DROP_DEFAULT_RULES_8\": \"Only finished spins will win a Prize.\",\n  \"PRIZE_DROP_DEFAULT_RULES_9\": \"#PRIZE_DROP_DEFAULT_TITLE campaign rules can be changed anytime.\",\n  \"PRIZE_DROP_DEFAULT_RULES_CUSTOM_PRIZE\": \"Players will get prizes within **​{payment_period}​** hours after end of the #PRIZE_DROP_DEFAULT_TITLE campaign.\",\n  \"PRIZE_DROP_DEFAULT_RULES_MAX_PRIZE\": \"The maximum payout for one bet multiplier prize is **​{max_prize_amount}​**.\",\n  \"PRIZE_DROP_DEFAULT_TITLE\": \"Prize Drops\",\n  \"PRIZE_DROP_DROPPED_PRIZES\": \"Total prizes dropped: {dropped_prizes}\",\n  \"PRIZE_DROP_GAMES_ALL\": \"all supported games\",\n  \"PRIZE_DROP_GAMES_ALL_EXCEPT\": \"all supported games (except {games_blacklist})\",\n  \"PRIZE_DROP_GAMES_ALL_EXCEPT_SHORT\": \"#PRIZE_DROP_GAMES_ALL*\",\n  \"PRIZE_DROP_HOT_PERIOD\": \"Hot Period\",\n  \"PRIZE_DROP_IS_OVER\": \"is over\",\n  \"PRIZE_DROP_IS_OVER_TITLE\": \"#PRIZE_DROP_DEFAULT_TITLE is over!\",\n  \"PRIZE_DROP_LEFT_PRIZES_AMOUNT\": \"{amount} left\",\n  \"PRIZE_DROP_MORE_INFO\": \"More info\",\n  \"PRIZE_DROP_MY_WINS\": \"My Wins\",\n  \"PRIZE_DROP_NO_WINNERS_YET\": \"no winners yet\",\n  \"PRIZE_DROP_POPUP_PRIZE_POOL\": \"Prize pool:\",\n  \"PRIZE_DROP_POPUP_PROGRESSIVE_PRIZE_POOL\": \"Progressive prize pool:\",\n  \"PRIZE_DROP_POPUP_PROGRESSIVE_PRIZE_POOL_STARTS_FROM\": \"Starts from\",\n  \"PRIZE_DROP_PRIZE\": \"Prize\",\n  \"PRIZE_DROP_PRIZES\": \"Prizes\",\n  \"PRIZE_DROP_PRIZES_DROPPED\": \"Prizes dropped\",\n  \"PRIZE_DROP_PRIZES_LEFT\": \"Left\",\n  \"PRIZE_DROP_PRIZES_LEFT_WIDGET\": \"Prizes left\",\n  \"PRIZE_DROP_PRIZES_VALUE\": \"Prizes value\",\n  \"PRIZE_DROP_RULES\": \"Rules\",\n  \"PRIZE_DROP_TIME\": \"Time\",\n  \"PRIZE_DROP_TIME_LEFT\": \"Time left:\",\n  \"PRIZE_DROP_TITLE_ENDS_IN\": \"Ends in:\",\n  \"PRIZE_DROP_TITLE_PLAYER_PRIZE_INFO\": \"the prize will be added to your balance within {payment_period} hours\",\n  \"PRIZE_DROP_TITLE_STARTS_IN\": \"Starts in:\",\n  \"PRIZE_DROP_TITLE_TOTAL_PRIZES\": \"Total\",\n  \"PRIZE_DROP_TOTAL_BETS\": \"x​{total_bet_multiplier} Total Bets\",\n  \"PRIZE_DROP_TOTAL_PRIZES\": \"{total_prizes} prizes!\",\n  \"PRIZE_DROP_WINNERS\": \"Winners\",\n  \"TORNAMENTS_RULES_RULE_SERIES_PLACE\": \"{series_place_score} points\",\n  \"TOURNAMENT_PRIZE_FREEBET_TYPE_FEATURE_BONUS\": \"Bonus Game\",\n  \"TOURNAMENT_PRIZE_FREEBET_TYPE_FEATURE_FREESPIN\": \"Bonus Game\",\n  \"TOURNAMENT_PRIZE_FREEBET_TYPE_FEATURE_FREESPINS\": \"Bonus Game\",\n  \"TOURNAMENT_PRIZE_FREEBET_TYPE_FIXED\": \"FB\",\n  \"TOURNAMENT_PRIZE_FREEBET_TYPE_FLEXIBLE\": \"Flexible FB\",\n  \"TOURNAMENTS_AWAILIBLE_TILL_TEXT\": \"Available till {time}.\",\n  \"TOURNAMENTS_BUTTON_CONTINUE\": \"Continue\",\n  \"TOURNAMENTS_BUTTON_PLAY_NOW\": \"Play now\",\n  \"TOURNAMENTS_DEFAULT_DESCRIPTION_EXPIRED\": \"The final Leaderboard results are still being calculated and will be available soon\\nAfter the tournament is finished, no further players’ actions will affect the leaderboard\\nAll leaderboard prizes will be credited manually to winners’ accounts by an operator within <span>​{payment_period} working hours</span>\",\n  \"TOURNAMENTS_DEFAULT_DESCRIPTION_FINISHED\": \"\",\n  \"TOURNAMENTS_DEFAULT_DESCRIPTION_NOT_STARTED\": \"1st place Prize <span>​{first_place_prize}​</span>\\nAvailable in: <span>​{games_list_short}​</span>\",\n  \"TOURNAMENTS_DEFAULT_DESCRIPTION_POST_NOTIFICATION\": \"\",\n  \"TOURNAMENTS_DEFAULT_DESCRIPTION_PRE_NOTIFICATION\": \"1st place Prize <span>​{first_place_prize}​</span>\\nAvailable in: <span>​{games_list_short}​</span>\",\n  \"TOURNAMENTS_DEFAULT_DESCRIPTION_STARTED\": \"1st place Prize <span>​{first_place_prize}​</span>\\n<span>​{prizes_count}​</span> winning positions\\nAvailable in: <span>​{games_list_short}​</span>\\nIn-game leaderboard and rules\\nThe leaderboard refreshes every <span>​{leaderboard_refresh_timeout} minutes</span>\\n{progressive_prize_description_additional}\",\n  \"TOURNAMENTS_DEFAULT_NAME\": \"Tournament\",\n  \"TOURNAMENTS_DEFAULT_RULE_21\": \"Freebets Prizes will be automatically credited to the winners’ accounts right after the end of this tournament\",\n  \"TOURNAMENTS_DEFAULT_RULE_22\": \"In order to use your Freebets Prizes, just log in to the appropriate game, for which they were awarded\",\n  \"TOURNAMENTS_DEFAULT_RULE_23\": \"Freebets Prizes in this tournament have a delayed start and will become available to winners starting from {0}\",\n  \"TOURNAMENTS_DEFAULT_RULE_24\": \"Freebets Prizes will be awarded to winners in 5 minutes after the end of the tournament\",\n  \"TOURNAMENTS_DEFAULT_RULE_25\": \"Freebets Prizes will be valid during {0} hours from the moment they were activated\",\n  \"TOURNAMENTS_DEFAULT_RULES\": \"1. #TOURNAMENTS_DEFAULT_RULES_1\\n1. #TOURNAMENTS_DEFAULT_RULES_2\\n1. #TOURNAMENTS_DEFAULT_RULES_3\\n1. #TOURNAMENTS_DEFAULT_RULES_4\\n1. #TOURNAMENTS_DEFAULT_RULES_5\\n1. #TOURNAMENTS_DEFAULT_RULES_6\\n1. #TOURNAMENTS_DEFAULT_RULES_7\\n1. #TOURNAMENTS_DEFAULT_RULES_8\\n#TOURNAMENTS_DEFAULT_RULES_9\\n1. #TOURNAMENTS_RULES_HOT_PERIOD\\n1. #TOURNAMENTS_DEFAULT_RULES_10\\n#TOURNAMENTS_DEFAULT_RULES_12\\n1. #TOURNAMENTS_DEFAULT_RULES_13\\n1. #TOURNAMENTS_DEFAULT_RULES_14\\n#TOURNAMENTS_DEFAULT_RULES_15\\n1. #TOURNAMENTS_DEFAULT_RULES_16\\n1. #TOURNAMENTS_DEFAULT_RULES_17\\n1. #TOURNAMENTS_DEFAULT_RULES_18\\n1. #TOURNAMENTS_DEFAULT_RULES_19\\n#TOURNAMENTS_DEFAULT_RULES_20\\n#TOURNAMENTS_DEFAULT_RULES_21\\n#TOURNAMENTS_DEFAULT_RULES_22\",\n  \"TOURNAMENTS_DEFAULT_RULES_1\": \"Only real mode rounds are able to participate in the tournament\",\n  \"TOURNAMENTS_DEFAULT_RULES_10\": \"Only finished spins will get to the leaderboard\",\n  \"TOURNAMENTS_DEFAULT_RULES_11\": \"Players can improve their results anytime during the tournament, only the highest tournament result is included in the leaderboard\",\n  \"TOURNAMENTS_DEFAULT_RULES_11_RACE\": \"Players can improve their result during the tournament period, all the cumulated points will be presented on the leaderboard\",\n  \"TOURNAMENTS_DEFAULT_RULES_12\": \"{active_hype_description}\",\n  \"TOURNAMENTS_DEFAULT_RULES_13\": \"Players will get prizes within **​{payment_period}​** hours after end of the tournament\",\n  \"TOURNAMENTS_DEFAULT_RULES_14\": \"If 2 or more players are tied on a points total, the player who reached the points later will be ranked higher\",\n  \"TOURNAMENTS_DEFAULT_RULES_15\": \"{custom_prize_cost}\",\n  \"TOURNAMENTS_DEFAULT_RULES_16\": \"The tournament rules can be changed anytime\",\n  \"TOURNAMENTS_DEFAULT_RULES_17\": \"Malfunction voids all pays\",\n  \"TOURNAMENTS_DEFAULT_RULES_18\": \"By participating in the tournament you automatically agree to the Terms and Conditions outlined here and the rules established by the operator\",\n  \"TOURNAMENTS_DEFAULT_RULES_19\": \"The provider holds the right to cancel the tournament for an indefinite term without any payments according to the leaderboard in cases of emergency\",\n  \"TOURNAMENTS_DEFAULT_RULES_2\": \"Tournament games: **​{games_list}​**\",\n  \"TOURNAMENTS_DEFAULT_RULES_20\": \"{progressive_prize_description}\",\n  \"TOURNAMENTS_DEFAULT_RULES_21\": \"{free_bets_prize_description}\",\n  \"TOURNAMENTS_DEFAULT_RULES_22\": \"{free_bets_prize_description_additional}\",\n  \"TOURNAMENTS_DEFAULT_RULES_23\": \"{largest_payout}\",\n  \"TOURNAMENTS_DEFAULT_RULES_24\": \"{win_race_macro}\",\n  \"TOURNAMENTS_DEFAULT_RULES_25\": \"{bet_race_macro}\",\n  \"TOURNAMENTS_DEFAULT_RULES_3\": \"Tournament runs between **​{start_time}​** **​{end_time}​**\",\n  \"TOURNAMENTS_DEFAULT_RULES_4\": \"In order to qualify your results, you have to make at least **​{min_rounds} spins** in tournament games. Unqualified players are not able to win any prize\",\n  \"TOURNAMENTS_DEFAULT_RULES_5\": \"The minimum bet required to take part in the tournament is **​{min_bet}​**\",\n  \"TOURNAMENTS_DEFAULT_RULES_6\": \"There are no additional costs to enter the tournament\",\n  \"TOURNAMENTS_DEFAULT_RULES_7\": \"Each player will get a personal tournament ID for the leaderboard\",\n  \"TOURNAMENTS_DEFAULT_RULES_8\": \"The leaderboard refreshes every **​{leaderboard_refresh_timeout} minutes** (in case of emergency can take up to 30 minutes)\",\n  \"TOURNAMENTS_DEFAULT_RULES_9\": \"{rules_win_rule_description}\",\n  \"TOURNAMENTS_GAME_NAME\": \"Free Bets are available in <span>​{game_name}​</span>\",\n  \"TOURNAMENTS_GAME_NAME_TIME\": \"Free Bets will be available in <span>​{game_name}​</span>\",\n  \"TOURNAMENTS_GAMES_ALL\": \"all supported games\",\n  \"TOURNAMENTS_GAMES_ALL_EXCEPT\": \"all supported games (except {games_blacklist})\",\n  \"TOURNAMENTS_GAMES_ALL_EXCEPT_SHORT\": \"#TOURNAMENTS_GAMES_ALL*\",\n  \"TOURNAMENTS_HOT_PERIOD\": \"Hot Period!\",\n  \"TOURNAMENTS_HOT_PERIOD_MULTIPLIER\": \"Points x⁠{multiplier}\",\n  \"TOURNAMENTS_LEADERBOARD_LAST_REFRESH\": \"Last refreshed {0} minutes ago\",\n  \"TOURNAMENTS_LEADERBOARD_NOT_QUALIFIED\": \"not qualified\",\n  \"TOURNAMENTS_LEADERBOARD_YOU\": \"You\",\n  \"TOURNAMENTS_MENU_MIN_BET\": \"Min bet is\",\n  \"TOURNAMENTS_MINI_WIDGET_FINISHED\": \"Finished\",\n  \"TOURNAMENTS_MINI_WIDGET_FORMING\": \"Forming.​.​.\",\n  \"TOURNAMENTS_MINI_WIDGET_MIN_BET\": \"Min bet is\",\n  \"TOURNAMENTS_MINI_WIDGET_STARTED\": \"#DAILY_WIDGET_STARTS_IN\",\n  \"TOURNAMENTS_PANEL_EXPIRED\": \"Forming the final leaderboard\",\n  \"TOURNAMENTS_PANEL_NOT_STARTED\": \"TOURNAMENT STARTS IN:\",\n  \"TOURNAMENTS_POPUP_PRIZE_POOL\": \"Prize pool:\",\n  \"TOURNAMENTS_POPUP_PROGRESSIVE_PRIZE_POOL\": \"Progressive prize pool:\",\n  \"TOURNAMENTS_POPUP_PROGRESSIVE_PRIZE_POOL_ADDITIONAL\": \"Prizes for places from <span>​{0}​</span> to <span>​{1}​</span> will grow during the tournament\",\n  \"TOURNAMENTS_POPUP_PROGRESSIVE_PRIZE_POOL_STARTS_FROM\": \"Starts from\",\n  \"TOURNAMENTS_PRIZE_FEATURE_FREESPINS\": \"Bonus game\",\n  \"TOURNAMENTS_PRIZE_FREEBET\": \"{count} FB\",\n  \"TOURNAMENTS_PRIZES_TRAVEL_PACKAGE\": \"Travel Package\",\n  \"TOURNAMENTS_RULES_ACTIVE_HYPE\": \"1. #TOURNAMENTS_RULES_ACTIVE_HYPE_INNER\",\n  \"TOURNAMENTS_RULES_ACTIVE_HYPE_INNER\": \"If a player on the leaderboard is idle for at least **​{active_hype_1_duration}​** minutes, then the player immediately below on the leaderboard will get additional points (provided that the player below qualifies for the tournament). Idle duration and additional points: **​{active_hype_1_duration}​** minutes +**​{active_hype_1_amount}​%**, from **​{active_hype_2_duration}​** minutes to **​{active_hype_3_duration}​** hours +**​{active_hype_2_amount}​%**, **​{active_hype_3_duration}​** hours plus **​{active_hype_3_amount}​%**\",\n  \"TOURNAMENTS_RULES_CUSTOM_PRIZE_PRICE\": \"1. #TOURNAMENTS_RULES_CUSTOM_PRIZE_PRICE_INNER\",\n  \"TOURNAMENTS_RULES_CUSTOM_PRIZE_PRICE_INNER\": \"All material prizes may be paid in money equivalent\",\n  \"TOURNAMENTS_RULES_FREEBETS_PRIZE\": \"1. #TOURNAMENTS_DEFAULT_RULE_21\\n1. #TOURNAMENTS_DEFAULT_RULE_22\",\n  \"TOURNAMENTS_RULES_FREEBETS_PRIZE_DELAYED\": \"1. #TOURNAMENTS_DEFAULT_RULE_23\",\n  \"TOURNAMENTS_RULES_FREEBETS_PRIZE_NORMAL\": \"1. #TOURNAMENTS_DEFAULT_RULE_24\",\n  \"TOURNAMENTS_RULES_HOT_PERIOD\": \"All players who do not occupy winner places get multiplier to their points earned during Hot Period when the Hot Period starts in the tournament\",\n  \"TOURNAMENTS_RULES_HSRW\": \"The player who achieved the highest win multiplier per single spin is awarded 1st place\",\n  \"TOURNAMENTS_RULES_LARGEST_WIN_TB\": \"The player who achieved the highest win multiplier per single spin is awarded 1st place\",\n  \"TOURNAMENTS_RULES_LARGEST_WIN_TB_MACRO\": \"The player who achieved the highest win multiplier per single spin is awarded 1st place\",\n  \"TOURNAMENTS_RULES_PROGRESSIVE_PRIZE\": \"1. #TOURNAMENTS_RULES_PROGRESSIVE_PRIZE_INNER\",\n  \"TOURNAMENTS_RULES_PROGRESSIVE_PRIZE_INNER\": \"The prize pool of this tournament will grow with each real bet made by tournament participants and will be distributed proportionally between winning positions. The more bets placed, the higher the prize amounts\",\n  \"TOURNAMENTS_RULES_RULE_BET_RACE\": \"1. #TOURNAMENTS_RULES_RULE_BET_RACE_1\\n1. #TOURNAMENTS_RULES_RULE_BET_RACE_2\\n1. #TOURNAMENTS_DEFAULT_RULES_11_RACE\",\n  \"TOURNAMENTS_RULES_RULE_BET_RACE_1\": \"The leaderboard includes players who accumulated the most points during the tournament\",\n  \"TOURNAMENTS_RULES_RULE_BET_RACE_2\": \"Players get points for the total bet amount in** {tournament_currency}​**, **​{points_currency}​** - 1 point\",\n  \"TOURNAMENTS_RULES_RULE_HSRP\": \"1. #TOURNAMENTS_RULES_RULE_LARGEST_PAYOUT\\n1. #TOURNAMENTS_DEFAULT_RULES_11\",\n  \"TOURNAMENTS_RULES_RULE_HSRW\": \"1. #TOURNAMENTS_RULES_RULE_LARGEST_WIN_TB_MACRO_INNER\\n1. #TOURNAMENTS_DEFAULT_RULES_11\",\n  \"TOURNAMENTS_RULES_RULE_LARGEST_PAYOUT\": \"The leaderboard includes the biggest payout per single spin in **​{tournament_currency}​**, **​{points_currency}​** - 1 point\",\n  \"TOURNAMENTS_RULES_RULE_LARGEST_WIN_TB\": \"1. #TOURNAMENTS_RULES_RULE_LARGEST_WIN_TB_MACRO_INNER\\n1. #TOURNAMENTS_DEFAULT_RULES_11\",\n  \"TOURNAMENTS_RULES_RULE_LARGEST_WIN_TB_MACRO\": \"1. #TOURNAMENTS_RULES_RULE_LARGEST_WIN_TB_MACRO_INNER\\n1. #TOURNAMENTS_DEFAULT_RULES_11\",\n  \"TOURNAMENTS_RULES_RULE_LARGEST_WIN_TB_MACRO_INNER\": \"The leaderboard is based on the highest single round win multiplier\",\n  \"TOURNAMENTS_RULES_RULE_MULTIPLACE_LEADERBOARD\": \"1. #TOURNAMENTS_RULES_RULE_MULTIPLACE_LEADERBOARD_1\\n1. #TOURNAMENTS_RULES_RULE_MULTIPLACE_LEADERBOARD_2\",\n  \"TOURNAMENTS_RULES_RULE_MULTIPLACE_LEADERBOARD_1\": \"Each player is eligible to hold more than one position on the leaderboard if the score is fit for the current leaderboard state\",\n  \"TOURNAMENTS_RULES_RULE_MULTIPLACE_LEADERBOARD_2\": \"The leaderboard is based on players' best results, every score that fits the current state of the leaderboard is eligible for the corresponding leaderboard position\",\n  \"TOURNAMENTS_RULES_RULE_MULTIPLIER_RACE\": \"1. #TOURNAMENTS_RULES_RULE_MULTIPLIER_RACE_1\\n1. #TOURNAMENTS_RULES_RULE_MULTIPLIER_RACE_2\\n1. #TOURNAMENTS_DEFAULT_RULES_11_RACE\",\n  \"TOURNAMENTS_RULES_RULE_MULTIPLIER_RACE_1\": \"The leaderboard includes players who accumulated the most points during the tournament\",\n  \"TOURNAMENTS_RULES_RULE_MULTIPLIER_RACE_2\": \"Players will get points for each win multiplier in a spin. 1 multiplier = 1 point\",\n  \"TOURNAMENTS_RULES_RULE_POINT_RACE\": \"1. #TOURNAMENTS_RULES_RULE_POINTS_RACE_TOTAL_WIN_MACRO_1\\n1. #TOURNAMENTS_DEFAULT_RULES_11_RACE\\n1. #TOURNAMENTS_RULES_RULE_POINTS_RACE_TOTAL_WIN_MACRO_2\\n{0}\",\n  \"TOURNAMENTS_RULES_RULE_POINTS_RACE_TOTAL_BET\": \"1. #TOURNAMENTS_RULES_RULE_POINTS_RACE_TOTAL_BET_1\\n1. #TOURNAMENTS_RULES_RULE_POINTS_RACE_TOTAL_BET_2\",\n  \"TOURNAMENTS_RULES_RULE_POINTS_RACE_TOTAL_BET_1\": \"The leaderboard includes users who accumulated the maximum points during the tournament\",\n  \"TOURNAMENTS_RULES_RULE_POINTS_RACE_TOTAL_BET_2\": \"In order to get points, players need to bet a specific amount. Each spin will reward a fixed amount of points, depending on the bet amount: {0}\",\n  \"TOURNAMENTS_RULES_RULE_POINTS_RACE_TOTAL_WIN_MACRO\": \"1. #TOURNAMENTS_RULES_RULE_POINTS_RACE_TOTAL_WIN_MACRO_1\\n1. #TOURNAMENTS_RULES_RULE_POINTS_RACE_TOTAL_WIN_MACRO_2\\n{0}\",\n  \"TOURNAMENTS_RULES_RULE_POINTS_RACE_TOTAL_WIN_MACRO_1\": \"The leaderboard includes users who accumulated the maximum points during the tournament\",\n  \"TOURNAMENTS_RULES_RULE_POINTS_RACE_TOTAL_WIN_MACRO_2\": \"Players get points based on the multiplier of spins won. See Points Table for details:\",\n  \"TOURNAMENTS_RULES_RULE_SERIES\": \"1. #TOURNAMENTS_RULES_RULE_SERIES_1\\n1. #TOURNAMENTS_RULES_RULE_SERIES_2\\n1. #TOURNAMENTS_RULES_RULE_SERIES_3\\n#TOURNAMENTS_RULES_RULE_SERIES_QUALIFIED\\n#TOURNAMENTS_RULES_RULE_SERIES_BET_SUM\\n#TOURNAMENTS_RULES_RULE_SERIES_PLACES\\n1. #TOURNAMENTS_RULES_RULE_SERIES_PRIZE_POOL\\n1. #TOURNAMENTS_RULES_RULE_SERIES_PRIZES\",\n  \"TOURNAMENTS_RULES_RULE_SERIES_1\": \"The campaign is conducted in the form of a tournament series from **​{start_time}​** till **​{end_campaign_time}​**\",\n  \"TOURNAMENTS_RULES_RULE_SERIES_2\": \"A series contains **​{series_tournaments_num}​** separate tournaments which can have different conditions\",\n  \"TOURNAMENTS_RULES_RULE_SERIES_3\": \"Players will get Extra Leaderboard points during the whole campaign for the following activities:\",\n  \"TOURNAMENTS_RULES_RULE_SERIES_BET_SUM\": \"{series_bet_sum}\",\n  \"TOURNAMENTS_RULES_RULE_SERIES_BET_SUM_FEED\": \"• Each **​{bet_sum_bet}​** bets - **​{bet_sum_score}​** points\",\n  \"TOURNAMENTS_RULES_RULE_SERIES_PLACES\": \"{series_places}\",\n  \"TOURNAMENTS_RULES_RULE_SERIES_PLACES_FEED\": \"• For the place taken in each leaderboard:\\n{places}\",\n  \"TOURNAMENTS_RULES_RULE_SERIES_PRIZE_POOL\": \"A tournament series contains an Extra Leaderboard with the following prize pool:\\n{prizepool}\",\n  \"TOURNAMENTS_RULES_RULE_SERIES_PRIZES\": \"Extra Leaderboard prizes are paid at the end of the entire campaign - **​{end_campaign_time}​**\",\n  \"TOURNAMENTS_RULES_RULE_SERIES_QUALIFIED\": \"{series_qualified}\",\n  \"TOURNAMENTS_RULES_RULE_SERIES_QUALIFIED_FEED\": \"• Tournament qualification - **​{qualified}​** points\",\n  \"TOURNAMENTS_RULES_RULE_STAKE_RACE\": \"1. #TOURNAMENTS_RULES_RULE_POINTS_RACE_TOTAL_BET_1\\n1. #TOURNAMENTS_RULES_RULE_POINTS_RACE_TOTAL_BET_2\\n1. #TOURNAMENTS_DEFAULT_RULES_11_RACE\",\n  \"TOURNAMENTS_RULES_RULE_WIN_RACE\": \"1. #TOURNAMENTS_RULES_RULE_WIN_RACE_1\\n1. #TOURNAMENTS_RULES_RULE_WIN_RACE_2\\n1. #TOURNAMENTS_DEFAULT_RULES_11_RACE\",\n  \"TOURNAMENTS_RULES_RULE_WIN_RACE_1\": \"The leaderboard includes players who accumulated the most points during the tournament\",\n  \"TOURNAMENTS_RULES_RULE_WIN_RACE_2\": \"Players get points for the total win spins amount in **​{tournament_currency}​**, **​{points_currency}​** - 1 point\",\n  \"TOURNAMENTS_RULES_TEXT_BET\": \"Bet\",\n  \"TOURNAMENTS_RULES_TEXT_IN_A_ROW\": \"**​{0}​** in a row\",\n  \"TOURNAMENTS_RULES_TEXT_MULTIPLIER\": \"**x​{0}​**\",\n  \"TOURNAMENTS_RULES_TEXT_MULTIPLIER_FROM_TO\": \"**≤x​{0} - <x​{1}​**\",\n  \"TOURNAMENTS_RULES_TEXT_MULTIPLIERS\": \"Multipliers\",\n  \"TOURNAMENTS_RULES_TEXT_POINTS\": \"Points\",\n  \"TOURNAMENTS_RULES_TEXT_POINTS_PLACEHOLDER\": \"**​{0}​** points\",\n  \"TOURNAMENTS_SERIES_CAMPAIGNS_FOOTER\": \"Prizes are paid at the end of all tournaments\",\n  \"TOURNAMENTS_SERIES_CAMPAIGNS_HEADER\": \"Your Series Progression\",\n  \"TOURNAMENTS_SERIES_CAMPAIGNS_ITEM_SCORES_BET_SUM\": \"Bets\",\n  \"TOURNAMENTS_SERIES_CAMPAIGNS_ITEM_SCORES_PLACE\": \"Place\",\n  \"TOURNAMENTS_SERIES_CAMPAIGNS_ITEM_SCORES_QUALIFIED\": \"Qualification\",\n  \"TOURNAMENTS_SERIES_CAMPAIGNS_ITEM_START_TS\": \"Starts in\",\n  \"TOURNAMENTS_SERIES_CAMPAIGNS_ITEM_STATUS_MISSED\": \"Missed\",\n  \"TOURNAMENTS_SERIES_LEADERBOARD_HEADER\": \"Tournament Series Leaderboard\",\n  \"TOURNAMENTS_SERIES_SCORE_TEXT\": \"Your score\",\n  \"TOURNAMENTS_SERIES_SLIDER_TITLE\": \"Your series progress\",\n  \"TOURNAMENTS_SERIES_TABLE_SHOW_PRIZES\": \"Show prizes\",\n  \"TOURNAMENTS_SERIES_TABLE_SHOW_SCORES\": \"Show scores\",\n  \"TOURNAMENTS_TITLE\": \"#TOURNAMENTS_WIDGET_TITLE\",\n  \"TOURNAMENTS_TITLE_CALCULATION_IN_PROGRESS\": \"Forming\\n<span>final leaderboard</span>\",\n  \"TOURNAMENTS_TITLE_END_TIME\": \"END TIME:\",\n  \"TOURNAMENTS_TITLE_ENDS_IN\": \"#DAILY_MINI_WIDGET_LAST_DAY\",\n  \"TOURNAMENTS_TITLE_FINISHED\": \"FINISHED\",\n  \"TOURNAMENTS_TITLE_GENERAL\": \"General\",\n  \"TOURNAMENTS_TITLE_LEADERBOARD\": \"Leader​board\",\n  \"TOURNAMENTS_TITLE_MIN_BET\": \"Tournament min bet is {min_bet}\",\n  \"TOURNAMENTS_TITLE_PLAYER\": \"Player\",\n  \"TOURNAMENTS_TITLE_PLAYER_FB_PRIZE_INFO\": \"Freebets will be added on {payment_time}\",\n  \"TOURNAMENTS_TITLE_PLAYER_PRIZE\": \"You w