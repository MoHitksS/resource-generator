            "size": 25824,
            "mimeType": "text/html",
            "text": "<!DOCTYPE html>\n<html>\n<head>\n    <meta charset=\"UTF-8\"/>\n    <meta http-equiv=\"X-UA-Compatible\" content=\"IE=8\"/>\n    <link rel=\"shortcut icon\" href=\"data:image/x-icon;,\" type=\"image/x-icon\">\n</head>\n<body>\n<script>\n    (function(window, app_config, app_config_url) {\n        function replaceDomainInConfig(config, domain) {\n            if (!domain) return;\n            if (config.desktop.use_cdn)\n                config.desktop.client_url = replaceDomainInURL(config.desktop.client_url, domain);\n            if (config.mobile.use_cdn)\n                config.mobile.client_url = replaceDomainInURL(config.mobile.client_url, domain);\n            if (config.gr.use_cdn)\n                config.gr.static_path = replaceDomainInURL(config.gr.static_path, domain);\n                if (config.available_games.length != null) {\n                    for (var i in config.available_games) {\n                        config.available_games[i].client_url = replaceDomainInURL(config.available_games[i].client_url, domain);\n                    }\n                }\n        }\n\n        function usesCDN(config) {\n            return config.desktop.use_cdn || config.mobile.use_cdn || config.gr.use_cdn;\n        }\n\n        function getStartScript(config) {\n            return config.gr.static_path + 'index.js?_ts=' + config.gr.revision;\n        }\n\n        var appStarted = false;\n\n        function xhr(url, options) {\n            options = options || {};\n            var xhr = new window.XMLHttpRequest();\n            xhr.onreadystatechange = function() {\n                if (xhr.readyState === 4) {\n                    if (xhr.status === 200) {\n                        options.success && options.success(xhr.responseText, xhr);\n                    } else {\n                        options.error && options.error(xhr);\n                    }\n                }\n            };\n            xhr.open(options.method || 'GET', url, true);\n            xhr.send(options.data || '');\n        }\n\n        function replaceDomainInURL(url, domain) {\n            if (!url) return url;\n            if (domain[domain.length - 1] !== '/') {\n                domain += '/';\n            }\n            return url.replace(/^([^/]*\\/\\/[^/]*)?\\/?/, domain);\n        }\n\n        function findBestCDN(config, callback) {\n            var checkImageFile = config.static_domains.metric_url,\n                staticDomainsLogUrl = config.static_domains.log_url,\n                staticDomainsUrl = config.static_domains.domains_url,\n                staticDomainsTimeout = config.static_domains.timeout,\n                firstDetected = false;\n\n            function logMessage(type, msg, data, number) {\n                if (!staticDomainsLogUrl) return;\n                xhr(staticDomainsLogUrl, {\n                    method: 'POST',\n                    data: JSON.stringify([{\n                        type: type,\n                        msg: msg,\n                        data: data,\n                        time: Number(new Date()),\n                        number: number\n                    }])\n                });\n            }\n\n            function startMetrics(staticDomains) {\n                if (!staticDomains.length) return callback();\n                setTimeout(callback, staticDomainsTimeout);\n                var i = 0;\n                while (staticDomains[i]) {\n                    velocityDetect(staticDomains[i]);\n                    i++;\n                }\n            }\n\n            function velocityDetect(domainAddress) {\n                var startTime = (new Date()).getTime();\n                xhr(domainAddress + checkImageFile, {\n                    method: 'HEAD',\n                    success: function() {\n                        var duration = (new Date()).getTime() - startTime;\n                        checkInDetection(domainAddress, duration);\n                    },\n                    error: function() {\n                        logMessage('error', 'CDN_METER_ERROR', domainAddress);\n                    }\n                });\n            }\n\n            function checkInDetection(domainAddress, duration) {\n                if (!firstDetected) {\n                    firstDetected = true;\n                    callback(domainAddress);\n                    logMessage('info', 'CDN_METER_FIRST', domainAddress, duration);\n                } else {\n                    logMessage('info', 'CDN_METER', domainAddress, duration);\n                }\n            }\n\n            xhr(staticDomainsUrl, {\n                success: function(resp) {\n                    var staticDomains = JSON.parse(resp).domains || [];\n                    startMetrics(staticDomains);\n                }\n            });\n        }\n\n        function startApp(config, domain) {\n            if (appStarted) return;\n            appStarted = true;\n\n            replaceDomainInConfig(config, domain);\n\n            window._PROVIDER = config;\n\n            var startScript = getStartScript(config);\n\n            var v = window.document.createElement('script');\n            v.setAttribute('type', 'text/javascript');\n            v.setAttribute('src', startScript);\n            window.document.getElementsByTagName('head')[0].appendChild(v);\n        }\n\n        function runWithConfig(config) {\n            if (!config) return\n\n            var useCDN = usesCDN(config),\n                forceStaticDomain = config.static_domains.force_domain;\n            if (!useCDN) {\n                startApp(config);\n            } else if (forceStaticDomain) {\n                startApp(config, '//' + forceStaticDomain);\n            } else {\n                findBestCDN(config, function(domain) {\n                    startApp(config, domain);\n                });\n            }\n        }\n\n        if (app_config) {\n            runWithConfig(app_config);\n        } else if (app_config_url) {\n            xhr(app_config_url + window.location.search, {\n                success: function(resp) {\n                    runWithConfig(JSON.parse(resp));\n                },\n                error: function(xhr) {\n                    if (xhr.responseText) document.write(xhr.responseText);\n                }\n            });\n        }\n    })(window, {\"available_games\": [{\"client_url\": \"https://static-s3.bng.games/gs/clients_kendoo/black_wolf_2/bng.v24.12.5/\", \"name\": \"black_wolf_2\", \"title\": \"Black Wolf 2\"}, {\"client_url\": \"https://static-s3.bng.games/gs/clients_kendoo/coin_up/bng.v24.12.3/\", \"name\": \"coin_up\", \"title\": \"Coin UP : Hot Fire\"}, {\"client_url\": \"https://static-s3.bng.games/gs/clients_goreel/tigers_gold/bng.v24.9.8/\", \"name\": \"tigers_gold\", \"title\": \"Tiger\\u2019s Gold\"}, {\"client_url\": \"https://static-s3.bng.games/gs/clients_ratpack/777_fruity_classic/bng.v24.10.10/\", \"name\": \"777_fruity_classic\", \"title\": \"777 Fruity Classic\"}, {\"client_url\": \"https://static-s3.bng.games/gs/clients_kendoo/coin_lightning/bng.v24.12.3/\", \"name\": \"coin_lightning\", \"title\": \"Coin UP : Lightning\"}, {\"client_url\": \"https://static-s3.bng.games/gs/clients_goreel/lamp_of_wonder/bng.v25.2.1/\", \"name\": \"lamp_of_wonder\", \"title\": \"Lamp of Wonder\"}, {\"client_url\": \"https://static-s3.bng.games/gs/clients_goreel/hawaii_riches/bng.v24.11.7/\", \"name\": \"hawaii_riches\", \"title\": \"Hawaii Riches\"}, {\"client_url\": \"https://static-s3.bng.games/gs/clients_goreel/grab_more_gold/bng.v24.11.6/\", \"name\": \"grab_more_gold\", \"title\": \"Grab more Gold!\"}, {\"client_url\": \"https://static-s3.bng.games/gs/clients_hraymo/olaf_viking/bng.v24.4.6/\", \"name\": \"olaf_viking\", \"title\": \"Olaf Viking\"}, {\"client_url\": \"https://static.bng.games/gs/clients_kendoo/3_coin_volcanoes/bng.v25.3.5/\", \"name\": \"3_coin_volcanoes\", \"title\": \"3 Coin Volcanoes\"}, {\"client_url\": \"https://static-s3.bng.games/gs/